---
import { overview } from '../data/site';

// Two timelines drawn to scale. Time runs down the page, newest at the top.
const PX_PER_YEAR = 44;
const PAD = 14;

const now = new Date();
const nowT = now.getFullYear() + now.getMonth() / 12;

// 'YYYY-MM' -> decimal year
const t = (key: string) => Number(key.slice(0, 4)) + (Number(key.slice(5)) - 1) / 12;

type Span = (typeof overview.work)[number];

const spans = [...overview.work, ...overview.education] as Span[];
const startOf = (s: Span) => t(s.start);
const endOf = (s: Span) => (s.point ? t(s.start) : s.end ? t(s.end) : nowT);

const minT = Math.min(...spans.map(startOf));
const maxT = Math.max(...spans.map(endOf), nowT);
const height = (maxT - minT) * PX_PER_YEAR + PAD * 2;
const y = (time: number) => (maxT - time) * PX_PER_YEAR + PAD;

// One bar (or dot) per item. A bar that runs past "now" is split: solid up to now, faded after.
const layout = (items: Span[]) =>
  items.map((s) => {
    const start = startOf(s);
    const end = endOf(s);
    const solidEnd = Math.min(end, nowT);
    return {
      ...s,
      center: s.point ? y(start) : (y(start) + y(end)) / 2,
      solid: { top: y(solidEnd), height: Math.max((solidEnd - start) * PX_PER_YEAR, 6) },
      future: end > nowT ? { top: y(end), height: (end - Math.max(start, nowT)) * PX_PER_YEAR } : null,
    };
  });

const work = layout(overview.work as Span[]);
const education = layout(overview.education as Span[]);

const years: number[] = [];
for (let yr = Math.ceil(minT); yr <= Math.floor(maxT); yr++) {
  // Skip a year tick that would collide with the "Now" label.
  if (Math.abs(yr - nowT) >= 0.3) years.push(yr);
}
---

<section class="mx-auto max-w-3xl border-y border-line px-6 py-12">
  <h2 class="sr-only">{overview.heading}</h2>

  <div class="grid grid-cols-[1fr_3.25rem_1fr] text-sm font-medium uppercase tracking-wide text-accent">
    <p class="pr-3 text-right">{overview.workTitle}</p>
    <span></span>
    <p class="pl-3">{overview.educationTitle}</p>
  </div>

  <div class="mt-3 grid grid-cols-[1fr_3.25rem_1fr]" style={`height: ${height}px`}>
    {/* Work lane (bars on the right edge, labels to their left) */}
    <div class="relative">
      {
        work.map((s) => (
          <>
            <div
              class="absolute right-0 w-1.5 rounded-full bg-work"
              style={`top: ${s.solid.top}px; height: ${s.solid.height}px`}
            />
            {s.future && (
              <div
                class="absolute right-0 w-1.5 rounded-full bg-work opacity-30"
                style={`top: ${s.future.top}px; height: ${s.future.height}px`}
              />
            )}
            <a
              href={s.href}
              class="absolute right-4 -translate-y-1/2 text-right leading-tight hover:text-accent"
              style={`top: ${s.center}px`}
            >
              <span class="block text-sm font-medium">{s.label}</span>
              <span class="block text-xs text-muted">{s.years}</span>
            </a>
          </>
        ))
      }
    </div>

    {/* Middle: year scale */}
    <div class="relative" aria-hidden="true">
      {
        years.map((yr) => (
          <span
            class="absolute left-0 right-0 -translate-y-1/2 text-center text-[11px] text-muted"
            style={`top: ${y(yr)}px`}
          >
            {yr}
          </span>
        ))
      }
      <span
        class="absolute left-0 right-0 -translate-y-1/2 text-center text-[11px] font-semibold text-accent"
        style={`top: ${y(nowT)}px`}
      >
        {overview.nowLabel}
      </span>
    </div>

    {/* Education lane (bars on the left edge, labels to their right) */}
    <div class="relative">
      {
        education.map((s) =>
          s.point ? (
            <>
              <div
                class="absolute -left-[3px] h-3 w-3 -translate-y-1/2 rounded-full bg-study"
                style={`top: ${s.center}px`}
              />
              <a
                href={s.href}
                class="absolute left-5 -translate-y-1/2 leading-tight hover:text-accent"
                style={`top: ${s.center}px`}
              >
                <span class="text-sm font-medium">{s.label}</span>
                <span class="ml-1.5 text-xs text-muted">{s.years}</span>
              </a>
            </>
          ) : (
            <>
              <div
                class="absolute left-0 w-1.5 rounded-full bg-study"
                style={`top: ${s.solid.top}px; height: ${s.solid.height}px`}
              />
              {s.future && (
                <div
                  class="absolute left-0 w-1.5 rounded-full bg-study opacity-30"
                  style={`top: ${s.future.top}px; height: ${s.future.height}px`}
                />
              )}
              <a
                href={s.href}
                class="absolute left-4 -translate-y-1/2 leading-tight hover:text-accent"
                style={`top: ${s.center}px`}
              >
                <span class="block text-sm font-medium">{s.label}</span>
                <span class="block text-xs text-muted">{s.years}</span>
              </a>
            </>
          ),
        )
      }
    </div>
  </div>

  <div class="mt-10 border-t border-line pt-8 text-center">
    <p class="text-sm font-medium uppercase tracking-wide text-accent">{overview.toolsTitle}</p>
    <p class="mt-2 text-2xl font-semibold tracking-tight">{overview.tools}</p>
  </div>
</section>
