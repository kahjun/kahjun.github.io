---
import type { Entry } from '../data/types';

interface Props {
  items: Entry[];
  tone?: 'work' | 'study'; // dot colour
}

const { items, tone = 'work' } = Astro.props;
---

<ol class="space-y-10 border-l border-line pl-6">
  {
    items.map((item) => (
      <li id={item.id} class="relative scroll-mt-20">
        <span
          class:list={[
            'absolute -left-[31px] top-2 h-3 w-3 rounded-full',
            tone === 'study' ? 'bg-study' : 'bg-work',
          ]}
        />
        <p class="text-sm text-muted">
          {item.period}
          {item.place && ` · ${item.place}`}
        </p>
        <h3 class="mt-1 text-lg font-semibold">{item.org}</h3>
        <p class="text-sm font-medium text-muted">{item.role}</p>
        <p class="mt-2">{item.plain}</p>
        {item.details && item.details.length > 0 && (
          <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-muted">
            {item.details.map((d) => <li>{d}</li>)}
          </ul>
        )}
      </li>
    ))
  }
</ol>
